@model List<Supplier>
@{
    ViewData["Title"] = "Suppliers";
}

<h1 class="mb-3">Suppliers</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No suppliers found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Supply items</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Phone</td>
                        <td>@item.Email</td>
                        <td>@item.SupplyItems.Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">@Model.Count supplier(s)</p>
}
