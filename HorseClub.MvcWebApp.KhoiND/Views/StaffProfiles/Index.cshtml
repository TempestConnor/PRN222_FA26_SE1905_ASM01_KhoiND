@model List<StaffProfile>
@{
    ViewData["Title"] = "Staff";
}

<h1 class="mb-3">Staff</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No staff found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Full name</th>
                    <th>Phone</th>
                    <th>Job title</th>
                    <th>Hire date</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FullName</td>
                        <td>@item.Phone</td>
                        <td>@((StaffJobTitle)item.JobTitle)</td>
                        <td>@item.HireDate?.ToString("yyyy-MM-dd")</td>
                        <td>@(item.IsActive ? "Yes" : "No")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">@Model.Count staff member(s)</p>
}
