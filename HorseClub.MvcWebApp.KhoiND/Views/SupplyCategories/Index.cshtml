@model List<SupplyCategory>
@{
    ViewData["Title"] = "Supply categories";
}

<h1 class="mb-3">Supply categories</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No supply categories found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Kind</th>
                    <th>Supply items</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@((SupplyKind)item.Kind)</td>
                        <td>@item.SupplyItems.Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">@Model.Count category(ies)</p>
}
