@model List<Horse>
@{
    ViewData["Title"] = "Horses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Horses</h1>
    <a asp-action="Create" class="btn btn-primary">New horse</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text" name="name" value="@ViewData["Name"]" class="form-control" placeholder="Name" />
    </div>
    <div class="col-md-3">
        <input type="text" name="breed" value="@ViewData["Breed"]" class="form-control" placeholder="Breed" />
    </div>
    <div class="col-md-3">
        <input type="text" name="ownerName" value="@ViewData["OwnerName"]" class="form-control" placeholder="Owner name" />
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No horses found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Microchip No</th>
                    <th>Sex</th>
                    <th>Breed</th>
                    <th>Color</th>
                    <th>Birth date</th>
                    <th>Status</th>
                    <th>Owner</th>
                    <th>Sire</th>
                    <th>Dam</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.MicrochipNo</td>
                        <td>@((HorseSex)item.Sex)</td>
                        <td>@item.Breed</td>
                        <td>@item.Color</td>
                        <td>@item.BirthDate.ToString("yyyy-MM-dd")</td>
                        <td>@((HorseStatus)item.Status)</td>
                        <td>@item.Owner?.FullName</td>
                        <td>@item.Sire?.Name</td>
                        <td>@item.Dam?.Name</td>
                        <td class="text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">@Model.Count horse(s)</p>
}
