@* Glider tabs from Uiverse.io (see wwwroot/css/tabs.css). Each radio carries its page URL;
   picking one slides the glider and then loads that page. *@
@{
    var tabs = new[]
    {
        (Controller: "Horses", Label: "Horses"),
        (Controller: "Owners", Label: "Owners"),
        (Controller: "StaffProfiles", Label: "Staff"),
        (Controller: "Suppliers", Label: "Suppliers"),
        (Controller: "SupplyCategories", Label: "Categories"),
        (Controller: "SupplyItems", Label: "Supply items")
    };
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
}

<div class="tabs-container">
    <div class="tabs">
        @for (var i = 0; i < tabs.Length; i++)
        {
            var id = $"tab-radio-{i + 1}";
            <input type="radio" id="@id" name="tabs" autocomplete="off"
                   value="@Url.Action("Index", tabs[i].Controller)"
                   checked="@(string.Equals(current, tabs[i].Controller, StringComparison.OrdinalIgnoreCase))"
                   onchange="location.href = this.value">
            <label class="tab" for="@id">@tabs[i].Label</label>
        }
        <span class="glider"></span>
    </div>
</div>
